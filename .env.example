# URL pública del sitio (para imágenes al compartir en redes)
SITE_URL=https://www.sanfranciscomuebles.cl

# ERP (endpoint REST de Seba: /api/ecommerce/productos). Si ERP_API_URL está vacío, la tienda usa datos de prueba.
ERP_API_URL=
ERP_API_KEY=
# Header de la API key del ERP
ERP_API_KEY_HEADER=X-API-Key
# Origen de las fotos de producto del ERP (si falta, se usa ERP_API_URL). Ej: http://144.91.88.57:3011
ERP_IMAGES_ORIGIN=

# Secreto compartido para que el ERP avise cambios: POST /api/erp/revalidate
ERP_WEBHOOK_SECRET=

# Carpeta donde se guardan las cotizaciones a medida (por defecto ./data/cotizaciones)
QUOTES_DIR=

# Webpay Plus. "integration" (por defecto) usa el ambiente de certificación de Transbank con sus credenciales
# públicas de prueba. Para cobrar de verdad: WEBPAY_ENV=production + código de comercio y API key reales.
WEBPAY_ENV=integration
WEBPAY_COMMERCE_CODE=
WEBPAY_API_KEY=

# Carpeta de pedidos pagados con Webpay (por defecto ./data/pedidos)
ORDERS_DIR=
